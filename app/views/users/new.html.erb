<div class="min-h-screen flex items-center justify-center bg-slate-900">
  <div class="flex flex-col gap-20">
    <div class="flex text-4xl font-bold items-end justify-center text-slate-100">Register new account</div>
    <div class="w-lg bg-slate-800 p-8 rounded-2xl">
      <%= form_with model: @user, url: register_path, method: :post do |form| %>
        <div class="flex flex-col gap-7 text-slate-100">
          <div class="flex flex-col gap-5">
            <div>
              <% if @user&.errors&.any? %>
                <div class="text-red-500">
                  <% @user.errors.full_messages.each do |message| %>
                    <span><%= message %></span>
                  <% end %>
                </div>
              <% end %>
              <%= form.label :name %>
              <%= form.text_field :name, class: "flex min-w-full border-1 px-2 py-1" %>
            </div>

            <div>
              <%= form.label :email %>
              <%= form.email_field :email, class: "flex min-w-full border-1 px-2 py-1" %>
            </div>

            <div>
              <%= form.label :password %>
              <%= form.password_field :password, class: "flex min-w-full border-1 px-2 py-1" %>
            </div>

            <div>
              <%= form.label :confirm_password %>
              <%= form.password_field :password_confirmation, class: "flex min-w-full border-1 px-2 py-1" %>
            </div>
          </div>

          <div class="flex flex-col gap-4">
            <%= form.submit "Register",
                            class: "w-fit rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700 cursor-pointer "
            %>
            <div>
              Already have an account?
              <%= link_to "Sign in here", root_path, data: { turbo_prefetch: false },
                          class: "text-blue-500 hover:text-blue-400"
              %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
