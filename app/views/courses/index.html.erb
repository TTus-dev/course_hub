<div class="flex w-full flex-col gap-10 p-6 text-slate-100">
  <div>
    <p class="text-3xl font-semibold">Browse courses</p>
  </div>

  <div class="px-4">
    <%= form_with url: courses_list_path, method: :get,
                  class: "flex flex-row items-center gap-4" do %>
      <div class="flex items-center gap-2">
        <%= check_box_tag "visibility[]", "public", Array(params[:visibility]).include?("public") %>
        <%= label_tag "visibility_public", "Public", class: "text-md text-slate-300 text-center" %>
      </div>

      <div class="flex items-center gap-2">
        <%= check_box_tag "visibility[]", "private", Array(params[:visibility]).include?("private") %>
        <%= label_tag "visibility_private", "Private", class: "text-md text-slate-300 text-center" %>
      </div>

      <%= submit_tag "Filter",
                     class: "rounded-lg border border-slate-700 bg-slate-800 px-2 py-1 text-sm hover:bg-slate-700" %>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col justify-between">
    <div class="flex flex-wrap gap-4">
      <% @courses.each do |course| %>
        <%= render "courses/course_card", course: course, show_enrollment: true %>
      <% end %>
    </div>
  </div>
</div>