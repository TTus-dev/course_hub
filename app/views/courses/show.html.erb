<div class="flex w-full flex-col p-6 text-slate-100 justify-between">
  <div class="flex flex-col gap-8">

    <!-- Course header -->
    <div>
      <p class="text-3xl font-semibold">
        <%= @course.name %>
      </p>

      <div class="mt-1 text-sm text-slate-400">
        <p>
          <%= @course.invite_code.present? ? "Private course" : "Public course" %>
        </p>

        <p>
          Instructor:
          <span class="text-slate-200">
            <%= @course.teacher.name %>
          </span>
        </p>

        <% if current_user == @course.teacher && @course.invite_code.present? %>
          <p class="mt-2">
            Invite code:
            <span class="font-mono text-slate-200">
              <%= @course.invite_code %>
            </span>
          </p>
        <% end %>
      </div>
    </div>


    <!-- Description -->
    <div class="max-w-4xl rounded-xl border border-slate-700 bg-slate-800 p-6">
      <p class="text-xl font-semibold">
        Description
      </p>

      <p class="mt-4 whitespace-pre-wrap wrap-break-word text-slate-400">
        <%= @course.description.presence || "No description provided." %>
      </p>
    </div>


    <!-- Students -->
    <div>
      <details class="group">
        <summary class="cursor-pointer text-xl font-semibold select-none">
          Students
        </summary>

        <div class="mt-4 rounded-xl border border-slate-700 bg-slate-800 p-4">
          <% if @students.any? %>
            <div class="flex flex-wrap gap-3">
              <% @students.each do |student| %>
                <div class="rounded-lg border border-slate-700 bg-slate-900/40 px-4 py-3">
                  <p class="text-sm font-medium text-slate-200">
                    <%= student.name %>
                  </p>

                  <p class="mt-1 text-sm text-slate-400">
                    <%= student.email %>
                  </p>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-slate-400">
              No students enrolled yet.
            </p>
          <% end %>
        </div>
      </details>
    </div>


    <!-- Classes -->
    <div class="flex flex-col gap-6">

      <details open>
        <summary class="cursor-pointer text-xl font-semibold select-none">
          Upcoming classes
        </summary>

        <div class="mt-4 flex flex-wrap gap-4">
          <% if @upcoming_classes.any? %>
            <% @upcoming_classes.each do |class_session| %>
              <%= render "dashboard/class_session_card",
                         class_session: class_session,
                         return_to: "course" %>
            <% end %>
          <% else %>
            <div class="rounded-xl border border-slate-700 bg-slate-800 p-4">
              <p class="text-sm text-slate-400">
                No upcoming classes.
              </p>
            </div>
          <% end %>
        </div>
      </details>


      <details>
        <summary class="cursor-pointer text-xl font-semibold select-none">
          Past classes
        </summary>

        <div class="mt-4 flex flex-wrap gap-4">
          <% if @past_classes.any? %>
            <% @past_classes.each do |class_session| %>
              <%= render "dashboard/class_session_card",
                         class_session: class_session,
                         return_to: "course" %>
            <% end %>
          <% else %>
            <div class="rounded-xl border border-slate-700 bg-slate-800 p-4">
              <p class="text-sm text-slate-400">
                No past classes.
              </p>
            </div>
          <% end %>
        </div>
      </details>

    </div>


    <!-- Assignments -->
    <div>
      <details>
        <summary class="cursor-pointer text-xl font-semibold select-none">
          Assignments
        </summary>

        <div class="mt-4 flex flex-col gap-3">
          <% if @assignments.any? %>
            <% @assignments.each do |assignment| %>
              <%= link_to assignment_path(assignment),
                          class: "block rounded-xl border border-slate-700 bg-slate-800 p-4
                                  hover:bg-slate-700" do %>

                <div class="flex items-start justify-between gap-6">
                  <div class="min-w-0">
                    <p class="font-medium text-slate-100">
                      <%= assignment.topic %>
                    </p>

                    <% if assignment.description.present? %>
                      <p class="mt-1 text-sm text-slate-400">
                        <%= truncate(assignment.description, length: 100) %>
                      </p>
                    <% end %>
                  </div>

                  <div class="shrink-0 text-right text-sm text-slate-400">
                    <% if assignment.due_at.present? %>
                      <p>
                        Due
                      </p>

                      <p class="text-slate-200">
                        <%= assignment.due_at.strftime("%d %b %Y, %H:%M") %>
                      </p>
                    <% else %>
                      <p>
                        No deadline
                      </p>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>

          <% else %>
            <div class="rounded-xl border border-slate-700 bg-slate-800 p-4">
              <p class="text-sm text-slate-400">
                No assignments yet.
              </p>
            </div>
          <% end %>

        </div>
      </details>
    </div>

  </div>


  <!-- Actions -->
  <div class="mt-8 flex gap-3 border-t border-slate-800 pt-6">
    <% unless @course.archived? %>
      <% if current_user == @course.teacher %>
        <%= link_to "Manage course",
                    courses_manage_path(@course.id),
                    class: "rounded-lg bg-slate-200 px-4 py-2 text-sm font-medium
                            text-slate-900 hover:bg-slate-300" %>

        <%= link_to "Create class",
                    new_class_session_path(
                      course_id: @course.id,
                      return_to: "show"
                    ),
                    class: "rounded-lg bg-slate-200 px-4 py-2 text-sm font-medium
                            text-slate-900 hover:bg-slate-300" %>

      <% elsif current_user.role == "student" %>
        <% if @enrollment %>
          <%= button_to "Leave course",
                        courses_leave_path(@course.id),
                        method: :delete,
                        class: "rounded-lg border border-red-900 px-4 py-2 text-sm
                                text-red-400 hover:bg-red-950" %>

        <% elsif @course.invite_code.present? %>
          <%= link_to "Enter invite code",
                      courses_invite_enroll_path(@course.id),
                      class: "rounded-lg bg-slate-200 px-4 py-2 text-sm font-medium
                              text-slate-900 hover:bg-slate-300" %>

        <% else %>
          <%= button_to "Enroll",
                        courses_enroll_path(@course.id),
                        method: :post,
                        class: "rounded-lg bg-slate-200 px-4 py-2 text-sm font-medium
                                text-slate-900 hover:bg-slate-300" %>
        <% end %>
      <% end %>
    <% end %>

    <%= link_to "Back",
                case params[:return_to]
                when "all"
                  courses_list_path
                when "my"
                  my_courses_path
                else
                  my_archived_courses_path
                end,
                class: "rounded-lg border border-slate-700 px-4 py-2 text-sm
                        hover:bg-slate-700" %>
  </div>
</div>
