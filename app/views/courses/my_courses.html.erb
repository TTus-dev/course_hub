<div class="flex w-full flex-col gap-10 p-6 text-slate-100">
  <div class="flex flex-col gap-5">
    <p class="text-3xl font-semibold">My Courses</p>
    <% if current_user.role == "teacher" %>
      <%= link_to "Create course",
                  courses_new_path,
                  class: "rounded-lg bg-slate-200 w-30 px-4 py-2 text-sm text-center font-medium text-slate-900
                hover:bg-slate-300" %>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col justify-between">
    <div class="flex flex-wrap gap-4">
      <% @courses.each do |course| %>
        <%= render "courses/course_card", course: course %>
      <% end %>

      <% if @courses.empty? %>
        <p class="rounded-xl border border-slate-700 bg-slate-800 p-4 text-sm text-slate-400">
          <%= current_user.role == "teacher" ?
                "You haven't created any courses yet." :
                "You haven't enrolled in any courses yet." %>
        </p>
      <% end %>
    </div>
  </div>
</div>