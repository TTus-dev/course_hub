<% show_enrollment = local_assigns.fetch(:show_enrollment, false) %>
<% return_to = local_assigns.fetch(:return_to, "all") %>

<div class="flex flex-col w-80 rounded-xl border border-slate-700 bg-slate-800
  shadow-sm justify-between text-slate-100 overflow-hidden">
  <%= link_to courses_show_path(id: course.id, return_to: return_to) do %>
    <div class="flex flex-col hover:bg-slate-700 p-4">
      <p class="text-sm text-slate-400">
        <%= course.invite_code.present? ? "Invite only" : "Public course" %>
      </p>

      <p class="text-xl">
        <%= course.name %>
      </p>

      <% if current_user.role == "student" %>
        <p class="text-sm text-slate-400">
          Instructor:
          <span class="text-slate-300">
            <%= course.teacher.name %>
          </span>
        </p>
      <% end %>

      <p class="min-w-0 line-clamp-3 wrap-break-word text-sm mt-1">
        <%= course.description %>
      </p>
    </div>
  <% end %>

  <% if (current_user.role == "teacher" && current_user == course.teacher) || current_user.role == "student" %>
    <div class="flex flex-row text-sm items-center p-3 border-t border-slate-700 <%= current_user.role == "teacher" ? "justify-end gap-2" : "justify-center" %>">
      <% if current_user.role == "teacher" %>
        <% if course.archived? %>
          <%= button_to "Reactivate",
                        courses_reactivate_path(course.id),
                        method: :patch,
                        data: { turbo: false },
                        onclick: "return confirm('Reactivate this course?');",
                        class: "rounded-lg border border-green-900 px-3 py-2 text-green-400 hover:bg-green-950" %>
        <% else %>
          <%= link_to "Manage",
                      courses_manage_path(course.id),
                      class: "rounded-lg border border-slate-700 px-3 py-2 hover:bg-slate-700" %>

          <%= button_to "Archive",
                        courses_archive_path(course.id),
                        method: :delete,
                        data: { turbo: false },
                        onclick: "return confirm('Archive this course?');",
                        class: "rounded-lg border border-red-900 px-3 py-2 text-red-400 hover:bg-red-950" %>
        <% end %>
      <% else %>
        <p class="text-slate-400">
          <%= Enrollment.exists?(course_id: course.id, user_id: current_user.id) ? "Enrolled" : "Not enrolled" %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>