<div class="flex w-full flex-col p-6 text-slate-100">

  <div class="flex flex-col gap-8">

    <div>
      <p class="text-3xl font-semibold">
        Create course
      </p>

      <p class="mt-1 text-sm text-slate-400">
        Create a new course for your students.
      </p>
    </div>

    <div class="max-w-2xl rounded-xl border border-slate-700 bg-slate-800 p-6">

      <p class="text-xl font-semibold">
        Course details
      </p>

      <%= form_with model: @course,
                    url: courses_path,
                    method: :post,
                    class: "mt-5 flex flex-col gap-5" do |form| %>

        <% if @course.errors.full_messages.first %>
          <span class="text-sm text-red-400"><%= @course.errors.full_messages.first %></span>
        <% end %>

        <div class="flex flex-col gap-1">
          <%= form.label :name,
                         class: "text-sm font-medium text-slate-300" %>

          <%= form.text_field :name,
                              class: "rounded-lg border border-slate-700 bg-slate-900
                                      px-3 py-2 text-slate-100 outline-none
                                      focus:border-slate-500" %>
        </div>

        <div class="flex flex-col gap-1">
          <%= form.label :description,
                         class: "text-sm font-medium text-slate-300" %>

          <%= form.text_area :description,
                             rows: 5,
                             class: "resize-none rounded-lg border border-slate-700
                                     bg-slate-900 px-3 py-2 text-slate-100
                                     outline-none focus:border-slate-500" %>
        </div>

        <div class="flex items-center gap-2">
          <%= form.check_box :invite_only,
                             class: "rounded border-slate-600 bg-slate-900" %>

          <%= form.label :invite_only,
                         "Invite only",
                         class: "text-sm text-slate-300" %>
        </div>

        <div>
          <%= form.submit "Create course",
                          class: "rounded-lg bg-slate-200 px-4 py-2 text-sm
                                  font-medium text-slate-900
                                  hover:bg-slate-300" %>
        </div>

      <% end %>
    </div>

  </div>

  <div class="mt-8 flex gap-3 border-t border-slate-800 pt-6">
    <%= link_to "Cancel",
                my_courses_path,
                class: "rounded-lg border border-slate-700 px-4 py-2 text-sm
                        hover:bg-slate-700" %>
  </div>

</div>