<h1>CourseHub Dashboard</h1>

<p>Logged in as <%= current_user.name %></p>
<p>Email: <%= current_user.email %></p>
<p>Role: <%= current_user.role %></p>
<%= button_to "Logout", logout_path, method: :delete %>

<ul >
  <li>
    <%= button_to "My active Courses", my_courses_path, method: :get %>
  </li>
  <li>
    <%= button_to "My archival Courses", my_archived_courses_path, method: :get %>
  </li>
</ul>