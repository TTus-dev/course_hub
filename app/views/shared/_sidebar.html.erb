<div class="flex flex-col w-60 min-h-screen bg-slate-800 text-slate-100 p-4">
  <div class="flex flex-row gap-3 items-center">
    <%= image_tag "/icon.svg", class: "w-10 h-10" %>
    <%= link_to "CourseHub", root_path, class: "text-2xl font-bold" %>
  </div>

  <div class="mt-4">

    <div class="text-sm text-slate-400">
      Logged in as:
    </div>

    <div class="font-semibold">
      <%= current_user.name %>
    </div>

    <div class="text-sm text-slate-400">
      <%= current_user.email %>
    </div>

    <div class="text-sm text-slate-400">
      <%= current_user.role.capitalize %>
    </div>
  </div>

  <nav class="flex flex-col gap-5 mt-5">
    <%= link_to "Dashboard", dashboard_path,
                class: "rounded-lg px-3 py-2 hover:bg-slate-700"
    %>

    <div class="flex flex-col">
      <div class="px-3 text-xs font-semibold text-slate-400">
        COURSES
      </div>

      <%= link_to "All courses", courses_list_path,
                  class: "rounded-lg px-3 py-2 hover:bg-slate-700"
      %>

      <%= link_to "My courses", my_courses_path,
                  class: "rounded-lg px-3 py-2 hover:bg-slate-700"
      %>

      <%= link_to "Schedule", my_courses_path,
                  class: "rounded-lg px-3 py-2 hover:bg-slate-700"
      %>
    </div>

    <div class="flex flex-col">
      <div class="px-3 text-xs font-semibold text-slate-400">
        ASSIGNMENTS
      </div>

      <%= link_to "Assignments", courses_list_path,
                  class: "rounded-lg px-3 py-2 hover:bg-slate-700"
      %>

      <%= link_to "Grades", my_courses_path,
                  class: "rounded-lg px-3 py-2 hover:bg-slate-700"
      %>
    </div>

  </nav>

  <div class="flex flex-1 items-end">
    <%= button_to "Log out", logout_path, method: :delete,
                  class: "w-full rounded-lg px-3 py-2 text-left hover:bg-slate-700 cursor-pointer" %>
  </div>
</div>