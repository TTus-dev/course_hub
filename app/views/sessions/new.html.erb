<div class="min-h-screen flex items-center justify-center">
  <div class="flex flex-col gap-20">
    <div class="flex text-4xl font-bold items-end justify-center text-slate-100">Welcome to CourseHub</div>
    <div class="w-lg bg-slate-800 p-8 rounded-2xl">
      <%= form_with url: login_path, method: :post do |form| %>
        <div class="flex flex-col gap-7 text-slate-100">
          <div class="flex flex-col gap-5">
            <div>
              <% if notice %>
                <div class="text-green-600">
                  <%= notice %>
                </div>
              <% end %>
              <%= form.label :email %>
              <%= form.email_field :email, class: "flex min-w-full border-1 px-2 py-1" %>
            </div>

            <div>
              <%= form.label :password %>
              <%= form.password_field :password, class: "flex min-w-full border-1 px-2 py-1" %>
            </div>
          </div>

          <div class="flex flex-col gap-4">
            <%= form.submit "Log in",
                            class: "w-fit rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700 cursor-pointer "
            %>
            <div>
              Don't have an account?
              <%= link_to "Register here", register_path, data: { turbo_prefetch: false },
                          class: "text-blue-500 hover:text-blue-400"
              %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
