<div class="min-h-screen flex items-center justify-center bg-slate-900">
  <div class="flex flex-col gap-20">
    <div class="flex text-4xl font-bold items-end text-slate-100">Welcome to CourseHub</div>
    <div class="bg-slate-800 p-8 rounded-2xl">
      <%= form_with url: login_path, method: :post do |form| %>
        <div class="flex flex-col gap-5 text-slate-100">
          <div>
            <%= form.label :email %>
            <%= form.email_field :email, class: "flex min-w-full border-1 px-2 py-1" %>
          </div>

          <div>
            <%= form.label :password %>
            <%= form.password_field :password, class: "flex min-w-full border-1 px-2 py-1" %>
          </div>

          <%= form.submit "Log in",
                          class: "w-full rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700 cursor-pointer"
          %>
        </div>
      <% end %>
    </div>
  </div>
</div>
