<h1>ClassSessions#new</h1>
<p>Find me in app/views/class_sessions/new.html.erb</p>

<%= form_with url: class_sessions_create_path(@course.id), method: :post do |form| %>
  <div>
    <%= form.label :topic %>
    <%= form.text_field :topic %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :starts_at %>a
    <%= form.datetime_local_field :starts_at %>
  </div>

  <div>
    <%= form.label :ends_at %>
    <%= form.datetime_local_field :ends_at %>
  </div>

  <div data-controller="location">
    <div>
      <%= form.label :location_type %>
      <%= form.select :location_type,
                      [["Physical", "physical"], ["Remote", "remote"]],
                      {},
                      data: {
                        location_target: "type",
                        action: "change->location#toggle"
                      } %>
    </div>

    <div data-location-target="physical">
      <div>
        <%= form.label :city %>
        <%= form.text_field :city %>
      </div>

      <div>
        <%= form.label :street %>
        <%= form.text_field :street %>
      </div>

      <div>
        <%= form.label :building_number %>
        <%= form.text_field :building_number %>
      </div>

      <div>
        <%= form.label :room %>
        <%= form.text_field :room %>
      </div>
    </div>

    <div data-location-target="remote">
      <div>
        <%= form.label :platform %>
        <%= form.text_field :platform %>
      </div>

      <div>
        <%= form.label :meeting_url %>
        <%= form.url_field :meeting_url %>
      </div>
    </div>
  </div>
  <%= form.submit "Create class" %>
<% end %>