<%= form_with model: @class_session,
              url: @class_session.new_record? ?
                     class_sessions_create_path :
                     class_session_update_path(@class_session.id),
              class: "mt-5 flex flex-col gap-5" do |form| %>

  <div class="flex flex-col gap-1">
    <%= form.label :course_id,
                   class: "text-sm font-medium text-slate-300" %>

    <%= form.collection_select :course_id,
                               @taught_courses,
                               :id,
                               :name,
                               {},
                               class: "rounded-lg border border-slate-700
                                             bg-slate-900 px-3 py-2 text-slate-100
                                             outline-none focus:border-slate-500" %>
  </div>

  <div class="flex flex-col gap-1">
    <%= form.label :topic,
                   class: "text-sm font-medium text-slate-300" %>

    <%= form.text_field :topic,
                        class: "rounded-lg border border-slate-700
                                      bg-slate-900 px-3 py-2 text-slate-100
                                      outline-none focus:border-slate-500" %>
  </div>

  <div class="flex flex-col gap-1">
    <%= form.label :description,
                   class: "text-sm font-medium text-slate-300" %>

    <%= form.text_area :description,
                       rows: 5,
                       class: "resize-none rounded-lg border border-slate-700
                                     bg-slate-900 px-3 py-2 text-slate-100
                                     outline-none focus:border-slate-500" %>
  </div>

  <div class="flex flex-col gap-1">
    <%= form.label :starts_at,
                   class: "text-sm font-medium text-slate-300" %>

    <%= form.datetime_local_field :starts_at,
                                  value: @class_session.starts_at&.strftime("%Y-%m-%dT%H:%M"),
                                  step: 60,
                                  class: "rounded-lg border border-slate-700
                                                bg-slate-900 px-3 py-2 text-slate-100
                                                outline-none focus:border-slate-500" %>
  </div>

  <div class="flex flex-col gap-1">
    <%= form.label :ends_at,
                   class: "text-sm font-medium text-slate-300" %>

    <%= form.datetime_local_field :ends_at,
                                  value: @class_session.ends_at&.strftime("%Y-%m-%dT%H:%M"),
                                  step: 60,
                                  class: "rounded-lg border border-slate-700
                                                bg-slate-900 px-3 py-2 text-slate-100
                                                outline-none focus:border-slate-500" %>
  </div>

  <div data-controller="location" class="flex flex-col gap-5">
    <div class="flex flex-col gap-1">
      <%= form.label :location_type,
                     class: "text-sm font-medium text-slate-300" %>

      <%= form.select :location_type,
                      [["Physical", "physical"], ["Remote", "remote"]],
                      {},
                      data: {
                        location_target: "type",
                        action: "change->location#toggle"
                      },
                      class: "rounded-lg border border-slate-700
                                    bg-slate-900 px-3 py-2 text-slate-100
                                    outline-none focus:border-slate-500" %>
    </div>

    <div data-location-target="physical"
         class="flex flex-col gap-5">
      <div class="flex flex-col gap-1">
        <%= form.label :city,
                       class: "text-sm font-medium text-slate-300" %>

        <%= form.text_field :city,
                            class: "rounded-lg border border-slate-700
                                          bg-slate-900 px-3 py-2 text-slate-100
                                          outline-none focus:border-slate-500" %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :street,
                       class: "text-sm font-medium text-slate-300" %>

        <%= form.text_field :street,
                            class: "rounded-lg border border-slate-700
                                          bg-slate-900 px-3 py-2 text-slate-100
                                          outline-none focus:border-slate-500" %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :building_number,
                       class: "text-sm font-medium text-slate-300" %>

        <%= form.text_field :building_number,
                            class: "rounded-lg border border-slate-700
                                          bg-slate-900 px-3 py-2 text-slate-100
                                          outline-none focus:border-slate-500" %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :room,
                       class: "text-sm font-medium text-slate-300" %>

        <%= form.text_field :room,
                            class: "rounded-lg border border-slate-700
                                          bg-slate-900 px-3 py-2 text-slate-100
                                          outline-none focus:border-slate-500" %>
      </div>
    </div>

    <div data-location-target="remote"
         class="flex flex-col gap-5">
      <div class="flex flex-col gap-1">
        <%= form.label :platform,
                       class: "text-sm font-medium text-slate-300" %>

        <%= form.text_field :platform,
                            class: "rounded-lg border border-slate-700
                                          bg-slate-900 px-3 py-2 text-slate-100
                                          outline-none focus:border-slate-500" %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :meeting_url,
                       class: "text-sm font-medium text-slate-300" %>

        <%= form.url_field :meeting_url,
                           class: "rounded-lg border border-slate-700
                                         bg-slate-900 px-3 py-2 text-slate-100
                                         outline-none focus:border-slate-500" %>
      </div>
    </div>
  </div>

  <div>
    <%= form.submit @submit_text,
                    class: "rounded-lg bg-slate-200 px-4 py-2 text-sm
                                  font-medium text-slate-900 hover:bg-slate-300" %>
  </div>
<% end %>